# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by git: never commit it.

# Database
MONGODB_URI=mongodb://localhost:27017/stes-ecommerce

# Server
PORT=9000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:9000

# Authentication
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET is required; the server refuses to start without it.
JWT_SECRET=change-me
# Optional separate secret for customer tokens (falls back to JWT_SECRET)
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_EXPIRES_IN=30d

# First admin account (used by the admin seed scripts)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Email notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Push notifications (Web Push)
# Generate a key pair with: cd backend && npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@stes.tn

# SMS - Tunisie Telecom
TUNISIETEL_SMS_ENABLED=false
TUNISIETEL_SMS_URL=https://api.tunisietel.tn/sms
TUNISIETEL_SMS_USERNAME=
TUNISIETEL_SMS_PASSWORD=
TUNISIETEL_SMS_SENDER_ID=STES

# SMS - Orange Tunisia
ORANGE_SMS_ENABLED=false
ORANGE_SMS_URL=https://api.orange.tn/sms
ORANGE_SMS_API_KEY=
ORANGE_SMS_SENDER_ID=STES

# SMS - Twilio (fallback)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payment gateways (enable each one once its credentials are filled in)
PAYMEE_ENABLED=false
PAYMEE_BASE_URL=https://api.paymee.tn
PAYMEE_API_KEY=
PAYMEE_SECRET_KEY=

FLOUCI_ENABLED=false
FLOUCI_BASE_URL=https://developers.flouci.com/api
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

D17_ENABLED=false
D17_BASE_URL=https://api.d17.tn
D17_MERCHANT_ID=
D17_SECRET_KEY=

KONNECT_ENABLED=false
KONNECT_BASE_URL=https://api.konnect.network
KONNECT_API_KEY=
KONNECT_RECEIVER_ID=
